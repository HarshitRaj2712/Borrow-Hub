PORT=4000
# Generate at least 64 random characters. The API refuses to start without it.
JWT_SECRET=replace-with-at-least-64-random-characters
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection used during backend startup.
MONGODB_URI=

# Razorpay test credentials; keep all three values on the backend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary server credentials; never expose these to the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP provider credentials for verification and notification email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:4000
# Email links open this frontend URL before calling the backend verification API.
FRONTEND_BASE_URL=http://localhost:5173

# Phone OTP provider; required before enabling phone verification.
SMS_PROVIDER=
SMS_API_KEY=
